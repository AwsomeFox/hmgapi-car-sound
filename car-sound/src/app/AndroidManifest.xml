<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.carsound.app" android:versionCode="14" android:versionName="0.6.0">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <!-- Gen5W: Activity.finish() throws SecurityException without it -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <application android:label="@string/app_name" android:allowBackup="false">
        <activity android:name=".MainActivity" android:label="@string/app_name"
            android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Holo.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
